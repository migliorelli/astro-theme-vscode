{
  "name": "astronvimtheme",
  "displayName": "AstroNvim Theme",
  "description": "AstroNvim AstroTheme palettes for VS Code and Cursor (AstroDark, AstroLight, AstroMars, AstroJupiter).",
  "version": "1.0.1",
  "publisher": "migliorelli",
  "icon": "icon.png",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "astrotheme",
    "astronvim",
    "dark",
    "light"
  ],
  "contributes": {
    "themes": [
      {
        "label": "AstroDark",
        "uiTheme": "vs-dark",
        "path": "./astrodark.json"
      },
      {
        "label": "AstroLight",
        "uiTheme": "vs",
        "path": "./astrolight.json"
      },
      {
        "label": "AstroMars",
        "uiTheme": "vs-dark",
        "path": "./astromars.json"
      },
      {
        "label": "AstroJupiter",
        "uiTheme": "vs",
        "path": "./astrojupiter.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AstroNvim/astrotheme"
  }
}